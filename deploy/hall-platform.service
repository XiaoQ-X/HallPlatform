[Unit]
Description=Hall Effect Teaching Platform
After=network.target

[Service]
Type=simple
User=hall
Group=hall
WorkingDirectory=/opt/hall/current
EnvironmentFile=/etc/hall/platform.env
ExecStart=/usr/bin/node /opt/hall/current/server/index.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/hall
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
