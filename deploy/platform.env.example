NODE_ENV=production
HOST=127.0.0.1
PORT=8182
HALL_DATA_DIR=/var/lib/hall/data
HALL_UPLOAD_DIR=/var/lib/hall/uploads
# Optional desktop installers, kept outside the application release tree.
HALL_DOWNLOAD_DIR=/var/lib/hall-downloads
# Generate privately on the server, e.g. openssl rand -hex 48.
HALL_JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_48_CHARACTERS
